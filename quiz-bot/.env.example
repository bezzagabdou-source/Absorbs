# ─── بوت المسابقات «برق» ───────────────────────────────────────────────
# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع .env إلى GitHub أبداً.

# رمز البوت من @BotFather (إلزامي في الإنتاج)
BOT_TOKEN=

# سرّ الـ webhook: سلسلة عشوائية طويلة (32 حرفاً على الأقل)
# يُستعمل في مسار الـ webhook وفي ترويسة X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=

# اسم البوت بدون @ (يُستعمل لبناء روابط الإحالة) — يُكتشف تلقائياً من getMe
BOT_USERNAME=

# روابط عامة HTTPS (إلزامي في الإنتاج)
PUBLIC_URL=

# معرّفات المدراء (آدمِن البوت) مفصولة بفواصل
ADMIN_IDS=

# كلمة سر لوحة التحكم (إلزامية في الإنتاج)
DASHBOARD_PASSWORD=

# سرّ توقيع جلسة اللوحة (عشوائي 32+ بايت)
SESSION_SECRET=

# قاعدة البيانات (SQLite). الافتراضي: ./data/barq.db
DB_PATH=

# السيرفر
PORT=8080
HOST=0.0.0.0

# وضع العرض التجريبي: بيانات وهمية جاهزة + لا اتصال حقيقي بتيليغرام (1/0)
DEMO=0

# ─── شبكة تيليغرام الآمنة (ضد الحظر) ───────────────────────────────────
# عدد الرسائل الصادرة في الثانية لكل البوت (سقف تيليغرام ~30)
TG_MSG_PER_SEC=22
# أقل فاصل بين رسالتين لنفس المحادثة (مللي ثانية)
TG_PER_CHAT_MS=1200
# عدد العمال المتوازيين في طابور الإرسال
TG_CONCURRENCY=8
# أقصى إعادة محاولة للرسالة الواحدة
TG_MAX_RETRIES=4
# سرعة البثّ الجماعي (رسالة/ثانية) — خليه منخفض باش ما تتشحّرش
BROADCAST_PER_SEC=18

# ─── الحماية من رشق النقاط ─────────────────────────────────────────────
# المستوى: off | normal | high | max
PROTECTION_LEVEL=max

# ─── عقل برق (ذكاء اصطناعي تنفيذي) ────────────────────────────────────
# مفتاح OpenRouter (المزوّد الأساسي)
OPENROUTER_API_KEY=
# مفتاح xAI / Grok (احتياطي أو أساسي)
XAI_API_KEY=
# النموذج المستعمل
AI_MODEL=x-ai/grok-4
AI_MODEL_GROK=grok-4
# (اختياري) توجيه المزوّد لبوّابة/بروكسي متوافق مع OpenAI
# AI_BASE_OPENROUTER=https://openrouter.ai/api/v1
# AI_BASE_XAI=https://api.x.ai/v1
