# Canonical HTTPS origin. Required in production; used for CSRF, not request Host headers.
APP_URL=http://localhost:3000
# Least-privilege runtime LOGIN role, NOT the migration owner. Created by db:migrate.
DATABASE_URL=
DATABASE_MIGRATION_URL=
PUSH_DATABASE_URL=
DB_RUNTIME_PASSWORD=
DB_WORKER_PASSWORD=
DB_POOL_MAX=5
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Passwords must be at least 24 characters. Never reuse the migration-owner password.
# Explicit development fixtures and preview-account endpoint. MUST be false/absent in production.
DEMO_MODE=false
# npm run push:keys. Keep the private key server-side; public key is safe for browsers.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@your-domain.example
# Optional local preview database only; never use embedded Postgres for production.
LOCAL_DB_PORT=55432
LOCAL_DB_PASSWORD=
LOCAL_DB_DIR=

# Only enable behind a proxy that OVERWRITES x-real-ip. Otherwise use a shared anonymous bucket.
TRUST_PROXY_HEADERS=false
# Exact HTTPS push-provider hostnames; protects the worker against arbitrary SSRF targets.
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com

# Server-side Gemini key. Never prefix with NEXT_PUBLIC. Shared from the existing Vercel team key.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Optional isolated PostgreSQL schema when reusing an existing database.
DB_SCHEMA=public
