# =====================================================================
#  بوت جيزي — إعدادات التشغيل المحلي (Polling)
#  انسخ هذا الملف إلى .env ثم املأ القيم. لا ترفع .env إلى Git أبداً.
# =====================================================================

# 1) توكن البوت من @BotFather
BOT_TOKEN=

# 2) مفتاح تشفير الجلسات (64 حرف hex) — ولّده بأمر:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=

# 3) بيانات عميل تطبيق جيزي (اختياري إن كانت لديك قيم أخرى)
DJEZZY_CLIENT_ID=6E6CwTkp8H1CyQxraPmcEJPQ7xka
DJEZZY_CLIENT_SECRET=MVpXHW_ImuMsxKIwrJpoVVMHjRsa
# زوج بديل يُجرَّب تلقائياً إذا رفضت جيزي الزوج الأول
DJEZZY_CLIENT_ID_LEGACY=87pIExRhxBb3_wGsA5eSEfyATloa
DJEZZY_CLIENT_SECRET_LEGACY=uf82p68Bgisp8Yg1Uz8Pf6_v1XYa

# 4) ترويسات تحاكي تطبيق الهاتف الرسمي
DJEZZY_USER_AGENT=MobileApp/3.0.9 (Android 13; DalilDjezzy)
DJEZZY_ACCEPT_LANGUAGE=ar-DZ

# 5) الشبكة
DJEZZY_BASE_URL=https://apim.djezzy.dz
DJEZZY_TIMEOUT_MS=45000
DJEZZY_RETRIES=2
# فرض IPv4 (يمنع ECONNABORTED/ETIMEDOUT على شبكات الهاتف) — 0 للتعطيل
DJEZZY_FORCE_IPV4=1
# وكيل اختياري (Proxy) — يُستعمل فقط إن كنت خارج شبكة جزائرية:
# DJEZZY_PROXY=http://user:pass@127.0.0.1:8080

# 6) هدايا
DJEZZY_GIFT_WALK_CODE=GIFTWALKWIN2GO
DJEZZY_SCAN_QR=https://www.djezzy.dz/scanwin-wd26?1

# 7) قيود
# أرقام جيزي فقط. ضع 7,6,5 لفتح بقية المشغّلين
ALLOWED_PREFIXES=7
