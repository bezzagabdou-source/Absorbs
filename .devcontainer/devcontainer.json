{
  "name": "OpenCode Server (Nexus)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install -g opencode-ai@latest",
  "postStartCommand": "bash .devcontainer/start-opencode.sh",
  "containerEnv": {
    "OPENCODE_SERVER_PASSWORD": "nexus-opencode-change-me"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "opencode server",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "remoteEnv": {
    "OPENCODE_SERVER_PASSWORD": "nexus-opencode-change-me"
  }
}
