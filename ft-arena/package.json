    "selftest": "node --experimental-strip-types --no-warnings --import ./scripts/register.mjs scripts/selftest.mjs",
    "ai-test": "node --experimental-strip-types --no-warnings --import ./scripts/register.mjs scripts/ai-test.mjs",
    "layout-test": "node scripts/layout-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.2.6",
    "@vercel/blob": "^2.0.0",
    "ioredis": "^5.4.2",
