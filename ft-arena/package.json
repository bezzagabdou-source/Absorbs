{
  "name": "mx-contests-bot",
  "version": "1.0.0",
  "private": true,
  "description": "مسابقات MX — بوت مسابقات MX + لوحة تحكم متكاملة (نقاط، إحالات، جوائز، ذكاء اصطناعي)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
