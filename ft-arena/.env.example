# ───────────────────────── إلزامي ─────────────────────────
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# كلمة مرور لوحة التحكم
ADMIN_PASSWORD=change-me-strong-password
# سر توقيع الجلسات (32 حرفًا عشوائيًا على الأقل)
AUTH_SECRET=please-generate-a-long-random-secret
# سر مسار الـ webhook: /api/tg/<WEBHOOK_SECRET>
WEBHOOK_SECRET=please-generate-a-random-path-secret

# ───────────────────────── التخزين ─────────────────────────
# Redis (Redis Cloud / Upstash TCP / أي redis) — الأسرع والأدق
REDIS_URL=redis://default:password@host:port
# بديل: Vercel Blob (سلسلة واحدة تُحفظ كملف JSON) يُستخدم تلقائيًا إن فشل Redis
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ───────────────────────── الذكاء الاصطناعي (اختياري) ─────────────────────────
# ضع أي مفتاح من هذه المفاتيح لتشغيل الكونسول الذكي بمحرّك LLM.
# بدونها يعمل الكونسول بمحرّك الفهم العربي المدمج (بدون أي مفتاح).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=

# ───────────────────────── اختياري ─────────────────────────
NEXT_PUBLIC_SITE_URL=
# رقم الأدمن (اختياري) لاستقبال إشعارات البوت مباشرة
ADMIN_CHAT_ID=
