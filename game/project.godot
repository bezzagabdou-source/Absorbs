; Engine configuration file — Nova Mira
[application]
config/name="Nova Mira"
config/description="Original open-world action-crime game for Android"
config/version="0.1.0"
config/features=PackedStringArray("4.4", "Mobile")
run/main_scene="res://scenes/Main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.035, 0.045, 0.075, 1)
config/icon="res://icon.svg"


[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
move_forward={"deadzone":0.2,"events":[{"type":2,"keycode":87},{"type":2,"keycode":4194320}]}
move_back={"deadzone":0.2,"events":[{"type":2,"keycode":83},{"type":2,"keycode":4194322}]}
move_left={"deadzone":0.2,"events":[{"type":2,"keycode":65},{"type":2,"keycode":4194319}]}
move_right={"deadzone":0.2,"events":[{"type":2,"keycode":68},{"type":2,"keycode":4194321}]}
sprint={"deadzone":0.2,"events":[{"type":2,"keycode":4194325}]}
jump={"deadzone":0.2,"events":[{"type":2,"keycode":32}]}
attack={"deadzone":0.2,"events":[{"type":2,"keycode":1},{"type":4,"button_index":0}]}
aim={"deadzone":0.2,"events":[{"type":2,"keycode":4194326}]}
interact={"deadzone":0.2,"events":[{"type":2,"keycode":69}]}
