[memory]
limits/global_variable_count=8192

[physics]
common/physics_ticks_per_second=60
3d/run_on_separate_thread=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatible"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
limits/render/clear_screen_no_depth=true
environment/defaults/default_clear_color=Color(0.05,0.08,0.14,1)

