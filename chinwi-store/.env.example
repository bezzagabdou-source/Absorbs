# ───────── إجباري ─────────
# قاعدة بيانات Postgres (Neon / Supabase / أي Postgres). يجب أن تحتوي sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# كلمة سر لوحة التحكم (يمكن تغييرها لاحقاً من الإعدادات)
ADMIN_PASSWORD=ضع-كلمة-سر-قوية-هنا

# سر توقيع جلسات اللوحة (أي نص عشوائي طويل)
ADMIN_SECRET=ضع-هنا-نصا-عشوائيا-طويلا

# سر تحقق تيليجرام للويبهوك (أي نص عشوائي)
TELEGRAM_WEBHOOK_SECRET=ضع-هنا-سرا-عشوائيا

# ───────── مهم ─────────
# يوزرنيم المالك بدون @ — يستلم إشعارات الطلبات ويتعرّف عليه البوت تلقائياً
OWNER_USERNAME=F_Q_Q_T

# رقم حساب المالك في تيليجرام (اختياري — يُضبط تلقائياً عند فتح البوت من حساب المالك)
# OWNER_CHAT_ID=123456789

# رابط الموقع (اختياري على Vercel — يُقرأ تلقائياً من VERCEL_PROJECT_PRODUCTION_URL)
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# ───────── الذكاء الاصطناعي (اختياري لكن مُنصح به) ─────────
# Groq: ردود سريعة جداً — console.groq.com/keys
GROQ_API_KEY=
# Google Gemini: تحليل الصور والرؤية — aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: احتياط لكل الموديلات — openrouter.ai/keys
OPENROUTER_API_KEY=

# تخصيص الموديلات (اختياري)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1

# ───────── تطوير/اختبار محلي فقط ─────────
# TELEGRAM_API_BASE=http://127.0.0.1:4001
# DB_POOL_MAX=2
# DB_IDLE_TIMEOUT=0
