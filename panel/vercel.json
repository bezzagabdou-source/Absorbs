{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ai.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/webhook.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/actions.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/app.css",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        }
      ]
    }
  ]
}