; APEX VELOCITY — project configuration
; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="APEX VELOCITY"
config/description="Premium arcade racing — night city, desert, mountain pass and coast."
config/version="2.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://assets/icon/app_icon.png"
boot_splash/bg_color=Color(0.02, 0.03, 0.06, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout=""
driver/mix_rate=44100

[autoload]

GameData="*res://scripts/autoload/GameData.gd"
Localization="*res://scripts/autoload/Localization.gd"
SettingsStore="*res://scripts/autoload/SettingsStore.gd"
Game="*res://scripts/autoload/Game.gd"
AudioDirector="*res://scripts/autoload/AudioDirector.gd"
UIStyle="*res://scripts/autoload/UIStyle.gd"
SceneRouter="*res://scripts/autoload/SceneRouter.gd"

[debug]

gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=1
theme/default_font_subpixel_positioning=1

