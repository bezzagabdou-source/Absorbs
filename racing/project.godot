[layer_names]

3d_render/layer_1="World"
3d_render/layer_2="Cars"
3d_render/layer_3="FX"
3d_render/layer_4="GaragePreview"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.81
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.05, 1)
limits/opengl/max_renderable_elements=262144
limits/opengl/max_renderable_lights=64
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/shadow_atlas/size=4096
reflect/reflection_atlas/reflection_size=256
occlusion_culling/use_occlusion_culling=true
