var current: String = "en"


func _ready() -> void:
	current = "en"


func set_language(code: String) -> void:
	if not STRINGS.has(code):
		code = "en"
	if code == current:
		return
	current = code
	language_changed.emit(code)


func is_rtl() -> bool:
	return current == "ar"


func tr_key(key: String) -> String:
	var table: Dictionary = STRINGS.get(current, {})
	if table.has(key):
		return table[key]
	var en: Dictionary = STRINGS["en"]
	if en.has(key):
		return en[key]
	return key


func trf(key: String, args: Array) -> String:
	var s: String = tr_key(key)
	if not s.contains("%"):
		return s
	if args.size() == 1:
		return s % args[0]
	return s % args


func t(key: String) -> String:
	return tr_key(key)
