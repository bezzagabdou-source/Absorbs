extends Node3D
## Cinematic 3D showroom used as the game's entry sequence.
##
## This is a real scene, not a painted backdrop: a shadowed studio with a turntable,
## a hero car, volumetric rim lighting and a slow dolly. It replaces the static
## illustration the boot screen used to zoom, because a flat image cannot react to
## the device, cannot show the paint shader, and reads as a menu rather than a game.
##
## Design constraints that shaped every number here:
##   * It must build in well under a second on a 4 GB phone. Nothing is loaded
##     from disk; the car is generated by CarModel, the room is boxes and planes.
##   * It must never show the renderer failing. If 3D cannot start, `ok` is false
##     and the caller falls back to the 2D intro without a black frame.
##   * It must be cheap while it is on screen: one reflection probe, one shadow
##     light, no SSAO, no per-frame allocations in _process.

const CarModelScript = preload("res://scripts/vehicle/CarModel.gd")

## Set false by the caller if the platform cannot provide a 3D viewport.
var ok: bool = false

var _car: Node3D = null
var _turntable: Node3D = null
var _camera: Camera3D = null
var _key: SpotLight3D = null
var _rim: SpotLight3D = null
var _fill: OmniLight3D = null
var _floor_mat: StandardMaterial3D = null

var _t: float = 0.0
var _orbit: float = 0.0
var _dolly: float = 0.0
var _paint: Color = Color(0.86, 0.14, 0.10)

## The camera path. A slow arc that starts low and close, rises, then settles —
## the same move a car advert makes in its first four seconds. Values are in
## metres and radians, resolved in _process from `_t`.
const CAM_START := Vector3(6.4, 1.05, 7.2)
const CAM_END := Vector3(-5.2, 2.35, 8.6)
const CAM_LOOK := Vector3(0.0, 0.72, 0.0)


func setup(paint: Color) -> bool:
	_paint = paint
	if not _build_studio():
		return false
	if not _build_car():
		return false
	ok = true
	return true


## A dark floor with a single pool of light, and a wall far enough back that it is
## only ever read as falloff. No textures: a tiled normal map on a floor is the
## fastest way to make a phone frame cost 6 ms for nothing at this camera height.
func _build_studio() -> bool:
	var env := WorldEnvironment.new()
	var e := Environment.new()
	e.background_mode = Environment.BG_COLOR
	e.background_color = Color(0.012, 0.014, 0.020)
	e.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	e.ambient_light_color = Color(0.16, 0.19, 0.26)
	e.ambient_light_energy = 0.55
	e.tonemap_mode = Environment.TONE_MAPPER_ACES
	e.tonemap_white = 6.0
	# A tight glow: the studio must feel like light falling off into black, not a
	# bloom smeared across the whole frame.
	e.glow_enabled = true
	e.glow_intensity = 0.55
	e.glow_strength = 1.0
	e.glow_bloom = 0.05
	e.glow_hdr_threshold = 1.1
	e.glow_blend_mode = Environment.GLOW_BLEND_MODE_ADDITIVE
	env.environment = e
	add_child(env)

	# floor: dark, rough, slightly reflective so the car has something to sit on
	var floor_mi := MeshInstance3D.new()
	var plane := PlaneMesh.new()
	plane.size = Vector2(60.0, 60.0)
	floor_mi.mesh = plane
	_floor_mat = StandardMaterial3D.new()
	_floor_mat.albedo_color = Color(0.035, 0.038, 0.046)
	_floor_mat.roughness = 0.22
	_floor_mat.metallic = 0.0
	_floor_mat.metallic_specular = 0.6
	floor_mi.material_override = _floor_mat
	floor_mi.position = Vector3(0.0, -0.001, 0.0)
	add_child(floor_mi)

	# turntable: a thin disc that catches the rim light and reads as a stage
	_turntable = Node3D.new()
	_turntable.name = "Turntable"
	add_child(_turntable)
	var disc := MeshInstance3D.new()
	var cyl := CylinderMesh.new()
	cyl.top_radius = 2.35
	cyl.bottom_radius = 2.35
	cyl.height = 0.06
	cyl.radial_segments = 64
	disc.mesh = cyl
	var disc_mat := StandardMaterial3D.new()
	disc_mat.albedo_color = Color(0.055, 0.060, 0.072)
	disc_mat.roughness = 0.12
	disc_mat.metallic = 0.85
	disc.material_override = disc_mat
	disc.position = Vector3(0.0, 0.03, 0.0)
	_turntable.add_child(disc)

	# a ring inlay: the light that traces the edge of the stage
	var ring_mi := MeshInstance3D.new()
	var torus := TorusMesh.new()
	torus.inner_radius = 2.30
	torus.outer_radius = 2.36
	torus.rings = 96
	torus.ring_segments = 8
	ring_mi.mesh = torus
	var ring_mat := StandardMaterial3D.new()
	ring_mat.albedo_color = Color(0.9, 0.75, 0.45)
	ring_mat.emission_enabled = true
	ring_mat.emission = Color(1.0, 0.78, 0.46)
	ring_mat.emission_energy_multiplier = 2.4
	ring_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	ring_mi.material_override = ring_mat
	ring_mi.position = Vector3(0.0, 0.055, 0.0)
	_turntable.add_child(ring_mi)

	_camera = Camera3D.new()
	_camera.fov = 42.0
	_camera.near = 0.05
	_camera.far = 80.0
	_camera.position = CAM_START
	add_child(_camera)
	_camera.look_at_from_position(CAM_START, CAM_LOOK, Vector3.UP)
	_camera.current = true

	# --- lighting: a classic three-point set, all shadow-mapped -------------
	_key = SpotLight3D.new()
	_key.position = Vector3(3.4, 5.6, 3.0)
	_key.spot_range = 22.0
	_key.spot_angle = 34.0
	_key.spot_angle_attenuation = 1.6
	_key.light_energy = 7.0
	_key.light_color = Color(1.0, 0.96, 0.90)
	_key.shadow_enabled = true
	_key.shadow_bias = 0.025
	_key.shadow_blur = 1.4
	add_child(_key)
	_key.look_at_from_position(_key.position, Vector3(0.0, 0.5, 0.0), Vector3.UP)

	_rim = SpotLight3D.new()
	_rim.position = Vector3(-4.6, 3.2, -4.0)
	_rim.spot_range = 24.0
	_rim.spot_angle = 40.0
	_rim.light_energy = 8.5
	_rim.light_color = Color(0.62, 0.80, 1.0)
	_rim.shadow_enabled = false
	add_child(_rim)
	_rim.look_at_from_position(_rim.position, Vector3(0.0, 0.8, 0.0), Vector3.UP)

	_fill = OmniLight3D.new()
	_fill.position = Vector3(0.0, 0.55, 4.6)
	_fill.omni_range = 12.0
	_fill.light_energy = 1.5
	_fill.light_color = Color(1.0, 0.92, 0.82)
	_fill.shadow_enabled = false
	add_child(_fill)
	return true


func _build_car() -> bool:
	var info: Dictionary = _hero_car()
	if info.is_empty():
		return false
	_car = CarModelScript.new()
	_car.name = "HeroCar"
	_turntable.add_child(_car)
	# CarModel reads GameData for its shape table; a missing table would throw, so
	# the build is guarded and the caller falls back to 2D.
	if not _car.has_method("build"):
		return false
	_car.build(info, str(info.get("paint", "cyan")), "split5")
	_car.position = Vector3(0.0, 0.06, 0.0)
	# A showroom pose: the car sits on the disc angled a few degrees off the
	# camera so the shoulder line and the front three-quarter are both visible.
	_car.rotation.y = deg_to_rad(-24.0)
	return true


## Picks the most expensive car the player already owns, so the showroom shows
## something they earned rather than a starter hatch every launch.
func _hero_car() -> Dictionary:
	var best: Dictionary = {}
	var best_rank: int = -1
	# Game exposes owned_ids(), not a list of car dictionaries. Resolving ids
	# through GameData keeps the showroom honest if the roster changes.
	var owned: Array = []
	for cid in Game.owned_ids():
		var rec: Dictionary = GameData.car_by_id(str(cid))
		if not rec.is_empty():
			owned.append(rec)
	if owned.is_empty() and not GameData.CARS.is_empty():
		owned = [GameData.CARS[0]]
	var class_rank := {"street": 0, "sport": 1, "super": 2, "hyper": 3, "classic": 1, "overland": 1}
	for c in owned:
		var rec: Dictionary = c
		if rec.has("id") and not rec.has("class"):
			rec = GameData.car_by_id(str(rec["id"]))
		if rec.is_empty():
			continue
		var r: int = int(class_rank.get(str(rec.get("class", "street")), 0))
		if r > best_rank:
			best_rank = r
			best = rec
	return best


func _process(delta: float) -> void:
	if not ok:
		return
	_t += delta
	# turntable: slow, constant, and never faster than 9 deg/s — a fast spin reads
	# as a loading screen rather than a showroom.
	_orbit += delta * 0.155
	_turntable.rotation.y = _orbit
	# dolly: ease from the low close start to the higher wide end over 6 s
	_dolly = clampf(_t / 6.0, 0.0, 1.0)
	var k: float = _dolly * _dolly * (3.0 - 2.0 * _dolly)
	var pos: Vector3 = CAM_START.lerp(CAM_END, k)
	_camera.position = pos
	_camera.look_at_from_position(pos, CAM_LOOK + Vector3(0.0, 0.04 * sin(_t * 0.7), 0.0), Vector3.UP)
	# key light breathes very slightly so the paint has moving specular highlights
	if _key != null:
		_key.light_energy = 7.0 + 0.35 * sin(_t * 1.1)


## Called by the boot screen when it hands over to the menu.
func teardown() -> void:
	ok = false
	if _car != null and is_instance_valid(_car):
		_car.queue_free()
	_car = null
