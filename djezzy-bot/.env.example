# =====================================================================
#  بوت جيزي — نموذج متغيّرات البيئة
#  انسخ هذا الملف إلى .env محلياً، وأضف نفس القيم في Vercel
#  (Project → Settings → Environment Variables)
# =====================================================================

# ---------------------------------------------------------------------
# 1) تيليجرام (إلزامي)
# ---------------------------------------------------------------------
# التوكن الذي حصلت عليه من @BotFather.
# ⚠️ مهم: التوكن الذي أرسلته في المحادثة أصبح مكشوفاً — افتح BotFather
#    ثم /revoke لإنشاء توكن جديد، وضع الجديد هنا فقط. لا تكتبه في الكود.
BOT_TOKEN=

# عنوان النشر العام (بدون / في النهاية). مثال: https://djezzy-bot.vercel.app
# على Vercel يمكن تركه فارغاً وسيُستنتج من VERCEL_PROJECT_PRODUCTION_URL
PUBLIC_URL=

# سرّي يتحقق منه تيليجرام في كل طلب Webhook (24-64 حرفاً: A-Z a-z 0-9 _ -)
# ولّده بالأمر:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SECRET=

# (اختياري لكن مُستحسن) قصر استخدام البوت على معرّف/معرّفات تيليجرام لك فقط.
# اتركه فارغاً ليكون البوت متاحاً للجميع. افصل بينها بفاصلة: 123456789,987654321
ALLOWED_TELEGRAM_IDS=

# ---------------------------------------------------------------------
# 2) التخزين الدائم للجلسات (مهم جداً على Vercel)
# ---------------------------------------------------------------------
# Vercel دوال Serverless بلا ذاكرة دائمة؛ بدون KV ستُفقد الجلسات عند كل
# إعادة تشغيل (بارد). أنشئ قاعدة Upstash Redis (خطة مجانية) أو Vercel KV
# ثم املأ القيمتين. الكود يعمل مع أي مزوّد يدعم Upstash REST API.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# لو كنت تستخدم Vercel KV تلقائياً ستأتي القيم بالأسماء:
# KV_REST_API_URL / KV_REST_API_TOKEN نفسها، فلا تحتاج تعديلاً.

# مفتاح تشفير رموز الجلسات (Access/Refresh Tokens) قبل تخزينها.
# 32 حرفاً على الأقل. ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# 3) محرّك جيزي (الواجهة الحقيقية لتطبيق جيزي)
# ---------------------------------------------------------------------
# True = محاكاة كاملة بلا شبكة (للاختبار فقط)
DJEZZY_DRY_RUN=false

# عنوان الـ API (لا تغيّره إلا إذا تغيّر رسمياً)
DJEZZY_BASE_URL=https://apim.djezzy.dz

# بيانات عميل تطبيق جيزي — ضعها في متغيّرات البيئة فقط (لا تُرفع إلى Git)
DJEZZY_CLIENT_ID=
DJEZZY_CLIENT_SECRET=

# ترويسة التطبيق
DJEZZY_USER_AGENT=MobileApp/3.0.9
DJEZZY_ACCEPT_LANGUAGE=fr
DJEZZY_TIMEOUT_MS=15000

# هدية 2 جيجا الأسبوعية + الهدية الترويجية
DJEZZY_GIFT_WALK_CODE=GIFTWALKWIN2GO
DJEZZY_SCAN_QR=https://www.djezzy.dz/scanwin-wd26?1

# باقة مدفوعة (اختياري تماماً) — لن تُفعّل إلا بعد تأكيد صريح في البوت
# تحذير: تفعيلها قد يخصم من الرصيد
OFFER_PAID_CODE=

# المسارات (افتراضية وجاهزة)
DJEZZY_PATH_REQUEST_OTP=/mobile-api/oauth2/registration
DJEZZY_PATH_VERIFY_OTP=/oauth2/token
DJEZZY_PATH_REFRESH=/oauth2/token
DJEZZY_PATH_HISTORY=/mobile-api/api/v1/subscribers/subscription-history/{msisdn}
DJEZZY_PATH_WALK_REWARD=/mobile-api/api/v1/services/walk/activate-reward/{msisdn}
DJEZZY_PATH_SCAN_REWARD=/mobile-api/api/v1/services/scan/activate-reward/{msisdn}
DJEZZY_PATH_ACTIVATE_PRODUCT=/mobile-api/api/v1/subscribers/activate-product/{msisdn}

# ---------------------------------------------------------------------
# 4) حدود الاستخدام
# ---------------------------------------------------------------------
# البوت يقبل أرقام جيزي فقط (+2137). ضع 7,6,5 لفتح بقية المشغّلين
ALLOWED_PREFIXES=7
MAX_NUMBERS_PER_USER=2
ACTION_COOLDOWN_MS=15000
MAX_CLAIMS_PER_DAY=6
