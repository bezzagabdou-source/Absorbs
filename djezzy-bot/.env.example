# =====================================================================
#  بوت جيزي — نموذج متغيّرات البيئة
#  انسخ هذا الملف إلى .env محلياً، وأضف نفس القيم في Vercel
#  (Project → Settings → Environment Variables)
# =====================================================================

# ---------------------------------------------------------------------
# 1) تيليجرام (إلزامي)
# ---------------------------------------------------------------------
# التوكن الذي حصلت عليه من @BotFather.
# ⚠️ مهم: التوكن الذي أرسلته في المحادثة أصبح مكشوفاً — افتح BotFather
#    ثم /revoke لإنشاء توكن جديد، وضع الجديد هنا فقط. لا تكتبه في الكود.
BOT_TOKEN=

# عنوان النشر العام (بدون / في النهاية). مثال: https://djezzy-bot.vercel.app
# على Vercel يمكن تركه فارغاً وسيُستنتج من VERCEL_PROJECT_PRODUCTION_URL
PUBLIC_URL=

# سرّي يتحقق منه تيليجرام في كل طلب Webhook (24-64 حرفاً: A-Z a-z 0-9 _ -)
# ولّده بالأمر:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SECRET=

# (اختياري لكن مُستحسن) قصر استخدام البوت على معرّف/معرّفات تيليجرام لك فقط.
# اتركه فارغاً ليكون البوت متاحاً للجميع. افصل بينها بفاصلة: 123456789,987654321
ALLOWED_TELEGRAM_IDS=

# ---------------------------------------------------------------------
# 2) التخزين الدائم للجلسات (مهم جداً على Vercel)
# ---------------------------------------------------------------------
# Vercel دوال Serverless بلا ذاكرة دائمة؛ بدون KV ستُفقد الجلسات عند كل
# إعادة تشغيل (بارد). أنشئ قاعدة Upstash Redis (خطة مجانية) أو Vercel KV
# ثم املأ القيمتين. الكود يعمل مع أي مزوّد يدعم Upstash REST API.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# لو كنت تستخدم Vercel KV تلقائياً ستأتي القيم بالأسماء:
# KV_REST_API_URL / KV_REST_API_TOKEN نفسها، فلا تحتاج تعديلاً.

# مفتاح تشفير رموز الجلسات (Access/Refresh Tokens) قبل تخزينها.
# 32 حرفاً على الأقل. ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# 3) محرّك جيزي (Djezzy API)
# ---------------------------------------------------------------------
# شغّل البوت أولاً بوضع المحاكاة (DRY RUN) للتأكد من سلامة الواجهة،
# ثم ضع عنوان الـ API الحقيقي والمسارات التي تستخرجها من حسابك الخاص.
DJEZZY_DRY_RUN=true

# عنوان الـ API الأساسي (بدون / في النهاية)
DJEZZY_BASE_URL=

# المسارات — عدّلها لتطابق ما تستخرجه من حركة تطبيق جيزي على جهازك.
DJEZZY_PATH_REQUEST_OTP=/request-otp
DJEZZY_PATH_VERIFY_OTP=/verify-otp
DJEZZY_PATH_REFRESH=/refresh-token
DJEZZY_PATH_PROFILE=/me
DJEZZY_PATH_OFFERS=/offers
DJEZZY_PATH_CLAIM_OFFER=/offers/{id}/claim
DJEZZY_PATH_GIFTS=/gifts
DJEZZY_PATH_CLAIM_GIFT=/gifts/{id}/claim
DJEZZY_PATH_CHALLENGE=/challenges/{id}/verify

# ترويسات تحاكي تطبيق جيزي الرسمي (عدّلها حسب إصدار التطبيق لديك)
DJEZZY_USER_AGENT=Djezzy/7.2.1 (Android 13; SM-A525F) okhttp/4.9.3
DJEZZY_ACCEPT_LANGUAGE=fr-DZ
DJEZZY_CLIENT_ID=
DJEZZY_APP_VERSION=7.2.1
DJEZZY_PLATFORM=android

# مهلة الطلبات (مللي ثانية) وحدود الاستخدام
DJEZZY_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# 4) حدود الاستخدام (تحمي حسابك من الحجب)
# ---------------------------------------------------------------------
MAX_NUMBERS_PER_USER=3
ACTION_COOLDOWN_MS=15000
MAX_CLAIMS_PER_DAY=6
