# =====================================================================
#  بوت جيزي — نموذج متغيّرات البيئة (v2)
#  انسخ هذا الملف إلى .env محلياً، وأضف نفس القيم في Vercel
#  (Project → Settings → Environment Variables)
# =====================================================================

# ---------------------------------------------------------------------
# 1) تيليجرام (إلزامي)
# ---------------------------------------------------------------------
# التوكن من @BotFather — يوضع في البيئة فقط ولا يُرفع إلى Git أبداً.
BOT_TOKEN=

# عنوان النشر العام (بدون / في النهاية). على Vercel يُستنتج تلقائياً.
PUBLIC_URL=

# سرّي يتحقق منه تيليجرام في كل طلب Webhook (16–256 حرفاً: A-Z a-z 0-9 _ -)
# ولّده:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SECRET=

# (اختياري) قصر الاستخدام على معرّفات محددة: 123456789,987654321
ALLOWED_TELEGRAM_IDS=

# ---------------------------------------------------------------------
# 2) التخزين الدائم للجلسات (إحدى الطرقين كافية)
# ---------------------------------------------------------------------
# الطريقة أ — Upstash/Vercel KV (إن أنشأت قاعدة):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# الطريقة ب — فرع bot-state في مستودع GitHub (تعمل بلا إعداد إضافي):
#   أنشئ فرعاً:  git push origin <فصلك>:bot-state
STATE_GITHUB_TOKEN=
STATE_GITHUB_REPO=owner/repo
STATE_GITHUB_BRANCH=bot-state
STATE_GITHUB_DIR=state

# مفتاح تشفير رموز الجلسات (32 حرفاً على الأقل):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# 3) محرّك جيزي (الواجهة الحقيقية — بيانات التطبيق مضمّنة افتراضياً)
# ---------------------------------------------------------------------
# true = محاكاة بلا شبكة (للاختبار فقط) — الافتراضي الآن false (مباشر)
DJEZZY_DRY_RUN=false

# عنوان الـ API الرسمي (لا تغيّره إلا إذا تغيّر رسمياً)
DJEZZY_BASE_URL=https://apim.djezzy.dz

# بيانات العميل مضمّنة في الكود (عمومية في تطبيق Djeزي) — يمكن تجاوزها:
DJEZZY_CLIENT_ID=
DJEZZY_CLIENT_SECRET=
DJEZZY_CLIENT_ID_LEGACY=
DJEZZY_CLIENT_SECRET_LEGACY=

DJEZZY_USER_AGENT=Djezzy/2.7.5
DJEZZY_TIMEOUT_MS=20000

# ---------------------------------------------------------------------
# 4) مسارات الوصول إلى جيزي (تجاوز الحجب الجغرافي)
# ---------------------------------------------------------------------
# الترتيب: relay ← مباشر ← بروكسياتك ← بروكسيات جزائرية عمومية (تلقائية)
DJEZZY_DIRECT=1
DJEZZY_AUTO_PROXY=1
# بروكسيات يدوية (افصلة بفواصل):
#   DJEZZY_PROXIES="http://user:pass@host:port,host:port:user:pass"
DJEZZY_PROXIES=
# خادم وسيط داخل الجزائر (شغّله من relay/ على جهاز في الجزائر):
DJEZZY_RELAY_URL=
DJEZZY_RELAY_TOKEN=

# ---------------------------------------------------------------------
# 5) الهدايا والعروض
# ---------------------------------------------------------------------
# هدية 2 جيجا الأسبوعية (Walk Win) — القيم الحقيقية الافتراضية:
DJEZZY_GIFT_WALK_CODE=GIFTWALKWIN2GO
DJEZZY_WALK_STEPS=10000
# هدية الجمعة/المناسبة (QR) — حدّث الرابط حسب الحملة الحالية:
DJEZZY_SCAN_QR=https://www.djezzy.dz/scanwin-wd26?1
# (اختياري) رمز باقة مدفوعة لزر «6 جيغا» — لا يُفعَّل إلا بتأكيد صريح:
OFFER_PAID_CODE=

# ---------------------------------------------------------------------
# 6) المسارات (افتراضية وجاهزة — راجع README)
# ---------------------------------------------------------------------
DJEZZY_PATH_REQUEST_OTP=/oauth2/registration
DJEZZY_PATH_VERIFY_OTP=/oauth2/token
DJEZZY_PATH_REFRESH=/oauth2/token
DJEZZY_PATH_SUBSCRIPTION_PRODUCT=/djezzy-api/api/v1/subscribers/{msisdn}/subscription-product?include=
DJEZZY_PATH_SUBSCRIBER=/djezzy-api/api/v1/subscribers/{msisdn}
DJEZZY_PATH_MGM=/djezzy-api/api/v1/subscribers/{msisdn}/member-get-member?include=
DJEZZY_PATH_SCAN_REWARD=/mobile-api/api/v1/services/scan/activate-reward/{msisdn}
DJEZZY_PATH_HISTORY=/mobile-api/api/v1/subscribers/subscription-history/{msisdn}

# ---------------------------------------------------------------------
# 7) الحدود
# ---------------------------------------------------------------------
MAX_NUMBERS_PER_USER=2
ACTION_COOLDOWN_MS=15000
MAX_CLAIMS_PER_DAY=6
ALLOWED_PREFIXES=7
