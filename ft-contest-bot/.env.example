# ─── Telegram ───────────────────────────────────────────────
# توكن البوت (يمكن أيضاً إدخاله من لوحة التحكم → الإعدادات)
TELEGRAM_BOT_TOKEN=
# سر الويب هوك (اختياري — يُنشأ تلقائياً)
TELEGRAM_WEBHOOK_SECRET=

# ─── التخزين (اختر واحداً) ───────────────────────────────────
# 1) Upstash Redis / Vercel KV (الأسهل)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# أو أسماء Vercel KV
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 2) Postgres (Neon / Supabase / Vercel Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/db
# POSTGRES_URL=postgresql://user:pass@host:5432/db

# ─── الذكاء الاصطناعي (اختياري — أول مفتاح متوفر كيتستعمل) ───
# Gemini (مجاني): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# بدائل مدعومة: OPENAI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY /
# CEREBRAS_API_KEY / DEEPSEEK_API_KEY / XAI_API_KEY / ANTHROPIC_API_KEY
# AI_MODEL=gemini-flash-latest
# قراءة صور مساعد اللوحة: Gemini ثم Groq ثم OpenRouter ثم OpenAI عند وجود مفاتيحها.
# تُرسل الصورة إلى البديل فقط عند فشل السابق. OpenRouter الافتراضي مجاني وقد يخضع لحدود.
# GEMINI_VISION_MODEL=gemini-flash-latest
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# OPENROUTER_VISION_MODEL=openrouter/free
# OPENAI_VISION_MODEL=gpt-4o-mini
# بدائل المساعد النصّي في اللوحة عبر مفتاح الربط؛ لا تكشف مفاتيح المزوّد للمتصفح.
# PANEL_GEMINI_MODEL=gemini-flash-latest
# PANEL_OPENROUTER_MODEL=openrouter/free
# حد الرسائل اليومية لكل مستخدم (افتراضي 30)
# AI_DAILY_LIMIT=30
# AI_ENABLED=0          # إطفاء كامل من البيئة
# AI_MOCK=1             # للاختبار المحلي بدون استهلاك المفتاح

# ─── الحماية ─────────────────────────────────────────────────
# سر توقيع جلسة الأدمن (اختياري — يُنشأ تلقائياً ويُخزَّن في قاعدة البيانات)
ADMIN_SECRET=
# كلمة مرور احتياطية للوحة (تُستخدم إن لم تُنشئ كلمة مرور من الواجهة)
# ADMIN_PASSWORD=

# للتطوير المحلي فقط: تشغيل البوت في وضع تجريبي بدون تيليغرام
# TELEGRAM_MOCK=1
