<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/bg_glass_card" android:elevation="4dp"
    android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/ivAvatar" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_circle_teal" android:src="@drawable/ic_user" android:tint="@color/white" android:padding="8dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink_soft" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/btnReport" android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:src="@drawable/ic_flag" android:tint="@color/ink_soft" />
    </LinearLayout>
    <TextView android:id="@+id/tvContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.35" android:textColor="@color/ink" android:textSize="15sp" />
    <ImageView android:id="@+id/ivPostImage" android:layout_width="match_parent" android:layout_height="240dp"
        android:layout_marginTop="10dp" android:scaleType="centerCrop" android:visibility="gone" />
    <FrameLayout android:id="@+id/videoBox" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="10dp" android:visibility="gone">
        <VideoView android:id="@+id/vvPost" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ImageView android:id="@+id/btnPlay" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center"
            android:background="@drawable/bg_circle_emerald" android:padding="18dp" android:src="@drawable/ic_play" android:tint="@color/white" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/btnLike" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_soft" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <ImageView android:id="@+id/ivLike" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_heart" android:tint="@color/ink_soft" />
            <TextView android:id="@+id/tvLikeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnComment" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:background="@drawable/bg_glass_soft" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chat" android:tint="@color/sky" />
            <TextView android:id="@+id/tvCommentCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/ink" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
