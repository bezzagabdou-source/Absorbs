<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card" android:elevation="6dp" android:gravity="center" android:orientation="vertical" android:padding="22dp">
            <ImageView android:id="@+id/ivProfileAvatar" android:layout_width="92dp" android:layout_height="92dp"
                android:background="@drawable/bg_circle_emerald" android:padding="20dp" android:src="@drawable/ic_user" android:tint="@color/white" />
            <TextView android:id="@+id/tvProfileName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvProfileUser" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/ink_soft" android:textSize="14sp" />
            <TextView android:id="@+id/tvProfileBio" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/ink" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/btnPrivacy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_glass_soft" android:padding="16dp" android:text="سياسة الخصوصية" android:textColor="@color/ink" android:textSize="15sp" />
        <TextView android:id="@+id/btnTerms" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/bg_glass_soft" android:padding="16dp" android:text="شروط الاستخدام وقواعد المجتمع" android:textColor="@color/ink" android:textSize="15sp" />
        <TextView android:id="@+id/btnOpenSite" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/bg_glass_soft" android:padding="16dp" android:text="فتح نسخة الويب الكاملة (ريلز، مجموعات، مكالمات)" android:textColor="@color/sky" android:textSize="15sp" />
        <TextView android:id="@+id/btnDeleteAccount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/bg_glass_soft" android:padding="16dp" android:text="حذف حسابي نهائيًا" android:textColor="#DC2626" android:textSize="15sp" />
        <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="16dp" android:background="@drawable/btn_primary_bg" android:text="تسجيل الخروج" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
