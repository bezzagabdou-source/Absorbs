<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="76dp" android:layout_height="wrap_content"
    android:layout_marginEnd="6dp" android:gravity="center" android:orientation="vertical" android:padding="4dp">
    <FrameLayout android:layout_width="68dp" android:layout_height="68dp">
        <View android:id="@+id/storyRing" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/bg_ring_new" />
        <ImageView android:id="@+id/ivStoryAvatar" android:layout_width="60dp" android:layout_height="60dp"
            android:layout_gravity="center" android:background="@drawable/bg_circle_teal" android:padding="12dp" android:src="@drawable/ic_user" android:tint="@color/white" />
    </FrameLayout>
    <TextView android:id="@+id/tvStoryName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@color/ink" android:textSize="11sp" />
</LinearLayout>
