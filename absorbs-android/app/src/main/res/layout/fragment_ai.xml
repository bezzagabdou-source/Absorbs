<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_circle_sky" android:padding="10dp" android:src="@drawable/ic_spark" android:tint="@color/white" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dz connect ai" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مساعدك الذكي — أفكار، تحسين منشورات، وأجوبة" android:textColor="@color/ink_soft" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAi" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false" android:padding="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <EditText android:id="@+id/etAi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/bg_input" android:hint="اسأل Dz connect ai…" android:maxLines="4"
            android:padding="14dp" android:textColor="@color/ink" android:textColorHint="@color/ink_soft" />
        <ImageView android:id="@+id/btnAiSend" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="8dp"
            android:background="@drawable/btn_primary_bg" android:padding="14dp" android:src="@drawable/ic_send" android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
