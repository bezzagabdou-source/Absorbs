<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="18dp"
        android:text="الرسائل" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvThreads" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:padding="12dp" />
        <ProgressBar android:id="@+id/pbThreads" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" />
        <TextView android:id="@+id/tvEmptyThreads" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="لا توجد محادثات بعد" android:textColor="@color/ink_soft" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
