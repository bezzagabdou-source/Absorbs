<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_soft" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/tvCommentName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/emerald" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvCommentBody" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:lineSpacingMultiplier="1.3" android:textColor="@color/ink" android:textSize="14sp" />
</LinearLayout>
