<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/d_glyph_anim">
    <target android:name="pulse">
        <aapt:attr name="android:scaleX">
            <objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
                android:propertyName="scaleX"
                android:valueFrom="0.72" android:valueTo="1.12"
                android:duration="620"
                android:interpolator="@android:interpolator/overshoot"
                android:repeatCount="1" android:repeatMode="reverse"/>
        </aapt:attr>
    </target>
    <target android:name="pulse">
        <aapt:attr name="android:scaleY">
            <objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
                android:propertyName="scaleY"
                android:valueFrom="0.72" android:valueTo="1.12"
                android:duration="620"
                android:interpolator="@android:interpolator/overshoot"
                android:repeatCount="1" android:repeatMode="reverse"/>
        </aapt:attr>
    </target>
    <target android:name="pulse">
        <aapt:attr name="android:alpha">
            <objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
                android:propertyName="alpha"
                android:valueFrom="0.35" android:valueTo="1.0"
                android:duration="480"
                android:repeatCount="1" android:repeatMode="reverse"/>
        </aapt:attr>
    </target>
</animated-vector>
