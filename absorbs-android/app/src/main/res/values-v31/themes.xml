<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: deep aurora backdrop with pulsing animated D glyph -->
    <style name="Theme.DZConnect" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorPrimaryDark">@color/indigo_deep</item>
        <item name="colorAccent">@color/fuchsia</item>
        <item name="android:statusBarColor">@color/pearl</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="android:windowSplashScreenAnimationDuration">1100</item>
    </style>
</resources>
