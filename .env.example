# ───────── Required ─────────
# PostgreSQL connection string (Neon / Supabase / Vercel Postgres). POSTGRES_URL also works.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ───────── Recommended ─────────
# Your public domain (used for sitemap / canonical / social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Secret (12+ chars) for the admin endpoint that creates promo codes
ADMIN_SECRET=

# ───────── Payments (optional) ─────────
CHARGILY_SECRET_KEY=
CHARGILY_MODE=live

# ───────── Firebase (optional overrides — defaults are built in) ─────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ───────── AI team (Pro "dream team": ALL engines work together) ─────────
# Add as many as you have — each engine that has a key joins the team automatically.
# Every engine drafts in parallel, then the lead engine merges everything into one
# stronger result (and automatically takes over from the next engine if it is down).
ANTHROPIC_API_KEY=          # Claude   (console.anthropic.com) — CLAUDE_API_KEY also works
DEEPSEEK_API_KEY=           # DeepSeek (platform.deepseek.com)
XAI_API_KEY=                # Grok     (console.x.ai) — GROK_API_KEY also works
HF_TOKEN=                   # Hugging Face (huggingface.co/settings/tokens) — HUGGINGFACE_API_KEY also works
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Task routing (on by default): the best engine that has a key leads each task.
#   Claude     -> PRIMARY: code, writing, reasoning, vision, MAX builds, final merge
#   Gemini     -> safety net + free tier
#   HuggingFace-> strong open models (Qwen3-Coder, DeepSeek-V3.1)
#   DeepSeek   -> math, logic, algorithms
#   Grok       -> creative ideas, bold angles
#   Groq       -> instant short answers
#   OpenRouter -> safety net + second opinion
# Set to off to use one fixed order for everything.
# BARQ_ROUTING=on
# Force one engine to always merge the drafts (overrides the task's best engine):
# claude | gemini | grok | deepseek | openrouter | groq
# BARQ_LEAD=claude
# Max wait for the drafting stage in ms (default 55000)
# BARQ_DRAFT_MS=55000
# Optional model overrides
# ANTHROPIC_MODEL=
# DEEPSEEK_MODEL=
# XAI_MODEL=
# HUGGINGFACE_MODEL=
# OPENROUTER_MODEL=
# GROQ_MODEL=

# ───────── ai-providers.ts (src/lib/ai-providers.ts) ─────────
# generateAIResponse(task, prompt): "code" | "fast" | "grok" | "reasoning"
# Each task has an automatic fallback chain; providers without a key are skipped.
# Do NOT wrap values in quotes and do NOT prefix with NEXT_PUBLIC_ (server only).
# (GEMINI_API_KEY is already set above)
#GEMINI_API_KEY=            # gemini-2.5-pro / gemini-2.5-flash  (aistudio.google.com/apikey)
OPENROUTER_API_KEY=        # Grok + Claude + DeepSeek            (openrouter.ai/keys)
GROQ_API_KEY=              # llama-3.3-70b-versatile              (console.groq.com/keys)
CEREBRAS_API_KEY=          # llama3.1-70b (code / debugging)      (cloud.cerebras.ai)
# Optional model overrides (use if a provider retires a model):
# CEREBRAS_MODEL=llama3.1-70b
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_PRO_MODEL=gemini-2.5-pro
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# OPENROUTER_GROK_MODEL=x-ai/grok-2-1212
# OPENROUTER_GROK_FALLBACK=x-ai/grok-4-fast
# OPENROUTER_CLAUDE=on   # paid: only if your OpenRouter account has credits
# OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-chat-v3.1
# OPENROUTER_DEEPSEEK_R1_MODEL=deepseek/deepseek-r1

# --- v8.9 image studio (optional) ---
# Uses GEMINI_API_KEY first (Gemini image models). Optional override of the first model tried:
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Fallbacks: HF_TOKEN (FLUX.1-schnell) then Pollinations (no key).

# ───────── v9.5 model selector: Grok (xAI) + OpenRouter (Pro plan only) ─────────
# Free plan: Gemini + Hugging Face open models.  Pro plan: also Grok and every OpenRouter model.
# Server only — never prefix with NEXT_PUBLIC_, no quotes.
GROK_API_KEY=                 # xAI Grok (console.x.ai). XAI_API_KEY above works as well.
# OPENROUTER_API_KEY is already defined above (openrouter.ai/keys)
# Optional:
# GROK_MODEL=grok-2-1212
# OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat-v3.1


# ───────── v10: Video Studio (/app/studio/video) ─────────
# At least one is needed. "auto" in the UI uses Replicate first, then Gemini Veo.
REPLICATE_API_TOKEN=            # replicate.com/account/api-tokens
# REPLICATE_VIDEO_MODEL=bytedance/seedance-1-lite   # any text-to-video model that accepts prompt / aspect_ratio / duration
# GEMINI_VIDEO_MODEL=veo-3.0-fast-generate-001      # Veo uses the GEMINI_API_KEY above (needs a paid Gemini API plan)

# --- v16: fused models & images (all optional) ---
# OPENROUTER_CLAUDE51_MODEL=anthropic/claude-sonnet-4.5   # put a newer Claude id here when available
# OPENROUTER_CLAUDE51_BACKUP=deepseek/deepseek-chat-v3.1
# OPENROUTER_KIMI_MODEL=moonshotai/kimi-k2                # set your Kimi code model id here
# OPENROUTER_IMAGE_MODEL=                                 # extra image engines, comma-separated, tried first

# ───────── v19: Unified AI Router Engine (src/lib/model-router.ts) ─────────
# Direct OpenAI + Anthropic connections (optional — without them, those engines
# are routed through OpenRouter automatically when OPENROUTER_API_KEY exists).
OPENAI_API_KEY=                  # OpenAI direct (platform.openai.com) — cost-aware fast/creative routing
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=               # any OpenAI-compatible endpoint
ANTHROPIC_API_KEY=               # Claude direct (console.anthropic.com)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# Routing preference override at request time is automatic; global weights via:
# ROUTER_PREFER=auto            # auto | cheap | fast | quality

# ───────── v19: Long-Term Vector Memory & RAG (nexus-rag/ + src/lib/memory.ts) ─────────
# Works out of the box (Postgres mirror + local embedder). Pinecone = production scale.
PINECONE_API_KEY=                # pinecone.io — managed vector index
PINECONE_INDEX=nexus-memory      # index name (serverless host resolved automatically)
# PINECONE_INDEX_HOST=           # optional static host (https://….pinecone.io)
# PINECONE_NAMESPACE=facts
# RAG_EMBED_PROVIDER=auto        # auto | gemini | openai | local
# GEMINI_EMBED_MODEL=text-embedding-004
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ───────── v19: Real-Time Voice & Vision streams (src/lib/realtime-stream.ts) ─────────
# Optional external realtime gateway (OpenAI Realtime / Gemini Live / self-hosted).
# Without it, sessions transparently use the built-in /api/realtime stream route.
# NEXT_PUBLIC_REALTIME_WS=wss://your-realtime-gateway.example

# ───────── v18: GPT-6 Astra · Qwen image · login speed ─────────
# GPT-6 Astra (Pro) uses OPENAI_API_KEY above. If OpenAI renames the id, set it here:
# OPENAI_ASTRA_MODEL=gpt-6-astra
# Hugging Face image models: Qwen-Image is tried first for quality tiers, FLUX.1-schnell for fast ones.
# HF_IMAGE_MODEL=Qwen/Qwen-Image        # any text-to-image model served by the HF router (optional)
# DB connections per serverless instance (default 5, max 20). Use a pooled DATABASE_URL for many users.
# DB_POOL_MAX=5
