# ─────────────────────────────────────────────────────────────────────────────
# NEXUS AI — environment (copy to .env.local for local dev)
#
# The app WORKS WITH ZERO env vars: local accounts + in-memory storage +
# the built-in offline engine. Everything below adds real capabilities.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage (optional but recommended) ──────────────────────────────────────
# Postgres connection string (Neon / Supabase / Render / Vercel Postgres).
# Without it the app automatically uses a fast in-memory store.
# For a zero-install local DB:  npm run db:dev  → copy the printed URL here.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── AI engines (at least ONE for real answers; all optional) ────────────────
# Google AI Studio (aistudio.google.com/apikey) — the safety net chain
GEMINI_API_KEY=
# Groq — instant replies (console.groq.com) — leads the "fast" chain
GROQ_API_KEY=
# Cerebras — fastest in class (cloud.cerebras.ai) — leads "ultra"
CEREBRAS_API_KEY=
# OpenRouter — Claude / DeepSeek / Grok / Kimi (openrouter.ai)
OPENROUTER_API_KEY=

# ── Site (recommended) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Admin (optional) — protects /api/admin/promo (12+ chars) ────────────────
ADMIN_SECRET=

# ── Firebase (optional overrides — the project defaults are built in) ───────
# Google sign-in uses the built-in project; override to use your own.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
