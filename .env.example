# ───────── Required ─────────
# Postgres (Neon / Supabase / Vercel Postgres). Point it at your existing DB to keep users, Pro plans and used codes.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ───────── AI engines (see src/lib/ai-providers.ts) ─────────
# Any key you set joins the fallback chains automatically; with NO key the offline demo engine answers.
#   Nexus Core / Flash -> "fast"      : Groq -> OpenRouter(DeepSeek) -> Cerebras -> Gemini Flash
#   Nexus Apex  (Pro)  -> "reasoning" : Gemini Pro -> DeepSeek R1 -> Claude (OpenRouter) -> Gemini Flash -> Groq
#   Nexus Forge (Pro)  -> "code"      : OpenRouter DeepSeek/Kimi -> Cerebras -> Gemini Pro -> Groq
GEMINI_API_KEY=            # aistudio.google.com/apikey
OPENROUTER_API_KEY=        # openrouter.ai/keys  (DeepSeek, Kimi, Grok, Claude)
GROQ_API_KEY=              # console.groq.com/keys
CEREBRAS_API_KEY=          # cloud.cerebras.ai
# Optional model overrides:
# GEMINI_PRO_MODEL=gemini-2.5-pro
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama3.1-70b
# OPENROUTER_FAST_MODEL=deepseek/deepseek-chat-v3.1
# OPENROUTER_CLAUDE_MODEL=anthropic/claude-sonnet-4.5

# ───────── Activation codes ─────────
# 12+ chars. Enables POST/GET /api/admin/promo (header x-admin-secret) to create codes without SQL.
# The built-in one-time codes live in src/lib/promo.ts.
ADMIN_SECRET=

# ───────── Firebase (sensible defaults below; web keys are public by design) ─────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# DB_POOL_MAX=5
